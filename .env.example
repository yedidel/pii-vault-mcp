# Copy this file to agent-adapter/.env and replace the placeholders.
# Docker Compose reads agent-adapter/.env for PostgreSQL.
# Do not commit agent-adapter/.env.

# PostgreSQL (docker-compose service "db" and the Bridge datasource)
POSTGRES_DB=bridge_db
POSTGRES_USER=bridge
POSTGRES_PASSWORD=change-me

# Bridge gRPC address used by the Agent Adapter
BRIDGE_GRPC_TARGET=localhost:50051

# Agent Adapter HTTP MCP server
MCP_TRANSPORT=http
ADAPTER_HOST=127.0.0.1
ADAPTER_PORT=8000
ADAPTER_PUBLIC_BASE=http://127.0.0.1:8000

# How the Bridge notifies the Adapter when a workflow finishes.
# Use POLLING instead of WEBHOOK only if you intentionally want the Adapter to poll.
CONNECTOR_TYPE=WEBHOOK
CONNECTOR_CONTEXT=http://127.0.0.1:8000/webhook/bridge

# Shared secret for Bridge -> Adapter webhook HMAC. Use a long random value.
WEBHOOK_SECRET=change-me-webhook-secret

# Bearer token for Adapter HTTP endpoints, including /mcp and /continuation/*.
# Claude Code's bridge-adapter entry must send this same value.
# bridge-wake loads it from agent-adapter/.env. Do not put it in .mcp.json.
ADAPTER_AUTH_TOKEN=change-me-adapter-token

# Install Directory used for pairing
INSTALL_DIRECTORY_URL=http://127.0.0.1:8010

# Demo registration form used by FILL_FORM
DEMO_FORM_URL=http://127.0.0.1:9000/register

# Provider credentials. Leave unused providers empty.
# Claude Code does not use an Anthropic API key in this project.
OPENAI_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY=   # accepted as an alias for GEMINI_API_KEY

# Optional model overrides
# OPENAI_MODEL=gpt-5.6
# GEMINI_MODEL=gemini-3.6-flash
