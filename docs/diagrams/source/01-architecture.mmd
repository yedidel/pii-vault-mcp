%% The Bridge — high-level architecture (current code only)
%% Figure 6.1
flowchart TB
  subgraph agents["AI Agent Layer"]
    CLAUDE["Claude Code\nMCP: bridge-adapter + bridge-wake"]
    OAI["openai-client"]
    GEM["gemini-client"]
    SDK["bridge-sdk BridgeClient"]
  end

  subgraph adapter["Agent Adapter — Python :8000"]
    MCP["FastMCP bridge-adapter\nsend_action / store_pii / get_action_status"]
    WH["POST /webhook/bridge"]
    SSE["GET /events SSE"]
    WAKE["WakeDispatcher\nClaudeProvider / OpenAIProvider / GeminiProvider / SdkProvider"]
    PII["PiiVaultStore Fernet"]
    PAIR["PairingService + PairingWatcher"]
    POLL["PollingWorker\nCONNECTOR_TYPE=POLLING"]
  end

  subgraph bridge["Bridge — Kotlin / Spring Boot"]
    GRPC["gRPC BridgeService :50051\nSendAction / GetActionStatus"]
    HTTP["HTTP :8081"]
    ENG["WorkflowEngine + Kafka workflow-events"]
    DB[("PostgreSQL\nactions + workflows")]
    WHC["WebhookContinuation"]
    CHC["ChannelContinuation"]
    POLC["PollingContinuation STUB"]
    THRC["ThreadContinuation STUB"]
    VWS["WebSocket /vault-websocket"]
  end

  subgraph peers["In-repo mocks / demo peers"]
    GMOCK["guardian-mock :8001"]
    VMOCK["mock-vault WS client"]
    DIR["install-directory :8010"]
    FORM["demo-forms :9000"]
  end

  CLAUDE -->|"MCP"| MCP
  OAI -->|"MCP + SSE"| MCP
  GEM -->|"MCP + SSE"| MCP
  SDK -->|"MCP + SSE"| MCP
  MCP --> PII
  MCP --> PAIR
  MCP -->|"gRPC insecure"| GRPC
  GRPC --> ENG
  ENG --> DB
  ENG -->|"GET /v1/authenticate/agent"| GMOCK
  ENG --> VWS
  VMOCK --> VWS
  VMOCK -->|"FILL_FORM HTTP"| FORM
  ENG --> WHC
  ENG --> CHC
  ENG --> POLC
  ENG --> THRC
  WHC -->|"HTTP POST HMAC"| WH
  WH --> WAKE
  POLL -->|"GetActionStatus"| GRPC
  POLL --> WAKE
  WAKE -->|"POST /wake"| CLAUDE
  WAKE -->|"Responses / Interactions APIs"| OAI
  WAKE --> GEM
  WAKE --> SSE
  PAIR -->|"optional"| DIR
  SSE --> OAI
  SSE --> GEM
  SSE --> SDK
