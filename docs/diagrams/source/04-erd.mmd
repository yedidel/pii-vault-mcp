erDiagram
  ACTIONS {
    string request_id PK
    string agent_id
    string user_install_id
    string action_type
    jsonb parameters_json
    jsonb context_json "unused on create"
    string status "StatusType"
    text result_data
    timestamp created_at
    timestamp updated_at
  }

  WORKFLOWS {
    string workflow_id PK
    string request_id UK "logical 1:1 to actions"
    string connector_type
    string connector_context
    string current_state "WorkflowState"
    string current_step "WorkflowStep"
    jsonb context_json
    timestamp created_at
    timestamp updated_at
    timestamp completed_at
    string last_executed_command "never written"
  }

  ACTIONS ||--|| WORKFLOWS : "request_id logical only"
